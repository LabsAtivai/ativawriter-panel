# Senha compartilhada única do time (RF v1 — sem multiusuário)
APP_PASSWORD=troque-esta-senha

# Segredo pra assinar o cookie de sessão (string longa e aleatória)
COOKIE_SECRET=troque-este-segredo

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# URL interna do painel de negativação (rede docker ativaai) — aba Negativação
NEGATIVACAO_API_URL=http://bounces-dashboard-1:8080

PORT=3300

# "production" liga cookie Secure (exige HTTPS) — usar atrás do reverse proxy
NODE_ENV=development
